{
  "name": "burn-clock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src && node --test scripts/fetch_live.test.mjs",
    "prepare:data": "python3 scripts/prepare_data.py",
    "test:browser": "node scripts/browser_checks.mjs",
    "test:numeric": "node scripts/numeric_browser_checks.mjs",
    "test:product": "node scripts/product_checks.mjs",
    "test:unit": "vitest run src"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "html-to-image": "^1.11.13",
    "@photostructure/tz-lookup": "11.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.12"
  }
